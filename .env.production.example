# .env.production.example - Template pour la configuration de production
# Copiez ce fichier en .env.production et personnalisez les valeurs
# AUCUNE valeur par défaut ne doit être utilisée en production

# Configuration de l'application
FLASK_ENV=production
PYTHONUNBUFFERED=1

# Les secrets sont gérés via les fichiers dans ./secrets/
# db_password.txt, secret_key.txt, postgres_user.txt, postgres_password.txt