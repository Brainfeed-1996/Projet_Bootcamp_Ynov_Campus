# PostgreSQL connection used directly by app.py.
# In Docker Compose, `db` is the PostgreSQL service hostname.
DATABASE_URL=postgresql://dev_user:dev_password@db:5432/music_hall

# Fallback PostgreSQL settings used when DATABASE_URL is not set.
# These values are examples only and must not be used in production.
DB_USER=dev_user
DB_PASSWORD=dev_password
DB_HOST=db
DB_PORT=5432
DB_NAME=music_hall

# Paths to Docker secrets mounted by compose.yaml.
# The corresponding secret files must contain the real development values.
DB_USER_FILE=/run/secrets/postgres_user
DB_PASSWORD_FILE=/run/secrets/db_password
SECRET_KEY_FILE=/run/secrets/secret_key
POSTGRES_USER_FILE=/run/secrets/postgres_user
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# PostgreSQL database name configured for the Compose database service.
POSTGRES_DB=music_hall

# Application signing key. Generate a cryptographically random value in production.
SECRET_KEY=replace-me-generate-random-in-production

# LLM provider selection: fake, openai, or ollama.
# `fake` is safe for offline development and deterministic tests.
LLM_PROVIDER=fake

# OpenAI provider settings. The key is a placeholder and must never be committed.
OPENAI_API_KEY=replace-with-placeholder-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# Ollama provider settings. Ollama must be running at the configured address.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=60

# Set to `1` to use the in-memory SQLite database for tests.
TESTING=0
