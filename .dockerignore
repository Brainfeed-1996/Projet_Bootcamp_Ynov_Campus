# .dockerignore - Exclusions pour le contexte de build
# Les fichiers listés ici ne sont pas envoyés dans le contexte Docker

# Fichiers d'environnement et secrets
.env
.env.production
*.env
secrets/

# Contrôle de version
.git/
.gitignore
.gitattributes

# Cache Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Fichiers de base de données
*.sqlite
*.sqlite3
*.db
postgres_data/

# Documentation
explications.md
README.md
CHANGELOG.md
docs/

# Fichiers de configuration Docker
docker-compose*.yml
docker-compose*.yaml

# Fichiers de logs
*.log
logs/

# Fichiers temporaires
*.tmp
*.temp
.DS_Store
Thumbs.db

# Fichiers d'IDE
.vscode/
.idea/
*.swp
*.swo

# Tests
test_*.py
conftest.py
tests/

# Fichiers de configuration locaux
*.local
*.development

# ---
# Note : Les fichiers Dockerfile, compose.yaml, requirements.txt,
# app.py, et les dossiers du projet (providers/, schemas/) sont inclus.
# Les secrets ne sont jamais inclus dans l'image.
# ---